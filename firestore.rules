rules_version = '2';

// Copy everything in this file into Firebase → Firestore Database → Rules.
//
// Each family's log lives under /families/<family code>/. The code is a long
// random string that only your phones know, and nobody can list the families,
// so the code works like a password.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{family}/{kind}/{id} {
      allow get, list: if family.size() == 20;
      allow create, update: if family.size() == 20
        && kind in ['sleeps', 'meta']
        && request.resource.data.keys().hasOnly(['start', 'end', 'updatedAt', 'deleted', 'value'])
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }
  }
}
